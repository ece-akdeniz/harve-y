# Copy to .env (never commit it). Real environment variables win over this file.
ARENA_URL=https://arena.tacto.ai
ARENA_API_KEY=
ARENA_DATA=data/package

# In-loop writer model. Must answer well inside 60 s per move: measure p95 before choosing.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=

# Optional second model for offline prep (no clock): dossier summaries, trait checks.
PREP_LLM_MODEL=

NEGOTIATOR_LOG_DIR=experiments/runs
# Hard per-move decision budget in seconds (arena limit is 60).
NEGOTIATOR_MOVE_BUDGET_S=35

# Shared experiment lab. Arena/model credentials stay in this file on each laptop.
# The host generates a separate ignored .lab-secrets.env with `negotiator lab init`.
# Teammates need LAB_URL, LAB_UPLOAD_TOKEN and their author name to publish results.
LAB_URL=
LAB_UPLOAD_TOKEN=
LAB_AUTHOR=
# Host: set --secure-cookies when sharing through the HTTPS VS Code forwarded URL.
